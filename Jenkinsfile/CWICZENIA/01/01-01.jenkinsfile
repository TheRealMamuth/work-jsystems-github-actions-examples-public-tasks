pipeline {
    agent any

    stages {
        stage('Przygotowanie') {
            steps {
                echo 'Start pipeline'
                echo 'Przygotowanie środowiska'
            }
        }

        stage('Budowanie') {
            steps {
                echo 'Pobieranie kodu'
                sh '''
                  ls -la /kuraczak
                  echo "wszystko dziala"
                '''
                echo 'Budowanie aplikacji'
                sh '''
                  exit 1
                '''
            }
        }

        stage('Testy') {
            steps {
                echo 'Uruchamianie testów'
                echo 'Testy zakończone'
            }
        }

        stage('Wdrozenie') {
            steps {
                echo 'Symulacja wdrożenia aplikacji'
            }
        }
    }
}
